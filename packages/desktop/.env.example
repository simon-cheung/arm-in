# 本地编译配置
# 复制此文件为 .env.local 并修改对应值

# CLI 二进制名称（默认: opencode-cli）
# 会同时修改: sidecar 文件名、Rust 编译常量、externalBin 路径
# OPENCODE_CLI_NAME=opencode-cli

# 图标主题: dev / beta（默认: dev）
# OPENCODE_ICON_THEME=dev

# # ============ cli 构建/版本相关 ============
# # 指定版本号 (如 1.4.6)
# OPENCODE_VERSION=10.0.1

# # 指定渠道 (如 latest, beta, 或 git 分支名)
# OPENCODE_CHANNEL=latest

# # 递增版本类型: major / minor / patch
# OPENCODE_BUMP=major

# # 是否创建 GitHub release: true
# OPENCODE_RELEASE=false
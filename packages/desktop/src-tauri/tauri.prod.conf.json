{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArmIn",
  "mainBinaryName": "ArmIn",
  "version": "0.1.0",
  "identifier": "com.ggvale.armin.desktop",
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "icons2/prod/32x32.png",
      "icons2/prod/128x128.png",
      "icons2/prod/128x128@2x.png",
      "icons2/prod/icon.icns",
      "icons2/prod/icon.ico"
    ],
    "externalBin": ["sidecars/armin-cli"],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons2/dev/icon.ico",
        "headerImage": "assets/nsis-header_armin.bmp",
        "sidebarImage": "assets/nsis-sidebar_armin.bmp"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/ai.opencode.opencode.metainfo.xml": "release/appstream.metainfo.xml"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwMDM5Nzg5OUMzOUExMDQKUldRRW9UbWNpWmNEOENYT01CV0lhOXR1UFhpaXJsK1Z3aU9lZnNtNzE0TDROWVMwVW9XQnFOelkK",
      "endpoints": ["https://github.com/anomalyco/opencode/releases/latest/download/latest.json"]
    }
  }
}
